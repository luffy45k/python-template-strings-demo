# Reproducible test image. Add runtime hardening with:
# docker run --rm --network none --read-only --tmpfs /tmp:rw,noexec,nosuid \
#   --memory 256m --cap-drop ALL python-template-strings-demo-test
FROM python:3.14-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN useradd --create-home --uid 1000 testuser
WORKDIR /app

COPY pyproject.toml README.md LICENSE ./
COPY src ./src
COPY tests ./tests
RUN python -m pip install ".[dev]" && chown -R testuser:testuser /app

USER testuser
ENTRYPOINT ["python", "-m", "pytest"]
CMD ["-q"]
